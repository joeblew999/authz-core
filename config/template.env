# config/template.env — schema for forking this repo to a new operator.
#
# Copy this to config/<env>.env (e.g. config/production.env) and fill in.
# All mise tasks default to env=production; pass `-- --env <env>` to switch.
#
# DO NOT COMMIT a filled-out config/<env>.env. They're gitignored.
# Real secrets (CF API tokens, etc.) live in fnox, not in these files.

# ── Cloudflare identity ──────────────────────────────────────────────────────

# Worker name (must be unique in your CF account).
CF_WORKER_NAME=authz-worker

# Your *.workers.dev subdomain (the part before .workers.dev).
CF_SUBDOMAIN=gedw99

# Derived URL for the deployed Worker — keep in sync with the two above.
CF_DEPLOY_URL=https://authz-worker.gedw99.workers.dev

# Local dev server URL.
DEV_URL=http://localhost:8787

# ── Cloudflare D1 ────────────────────────────────────────────────────────────

CF_D1_NAME=authz-store

# ── Repo / external sources ──────────────────────────────────────────────────

GITHUB_REPO_URL=https://github.com/joeblew999/authz-core
PGAUTHZ_INIT_URL=https://raw.githubusercontent.com/zvectorlabs/pgauthz/main/crates/pgauthz/sql/init.sql
